# Local secrets / env
.env
.env.local
.env.*.local
# Production env rendered from deploy/env.prod.example (per
# doc/burn-in-preflight.md §A.2 — every secret must use *_REF; raw
# values must never be committed).
.env.prod
# Staging sandbox env rendered from deploy/env.staging.example — local
# docker run only; raw secrets allowed (single-host sandbox).
deploy/env.staging

# Postgres data (volume mount)
data/

# Docker volumes
.docker-data/

# Skill pack trust store — priv keys never enter the repo
# `**/.eos/...` matches anywhere in the tree (backend/.eos/, frontend/.eos/,
# or a future top-level .eos/). The inner `**` then matches nested
# trust subdirs (e.g. backend/.eos/skill-trust/*.priv.pem). Public keys
# (*.pub.pem) remain trackable so shared dev trust stores can be committed.
**/.eos/**/*.priv.pem
**/.eos/**/*.priv
# Real SecretProviderClass / Secret rendered from infra/k8s/secret.example.yaml
# (per doc/burn-in-preflight.md §A.4 — gitleaks G5 will catch any leak).
infra/k8s/secret.yaml
infra/k8s/staging/secret.yaml

# ── Frontend (pnpm + Vite + TS) ────────────────────────────────────────────
# Frontend lives under frontend/ — pnpm workspace with web/ + packages/*.
# Source frontend/.gitignore handles package-local ignores; these root-level
# patterns are a defense-in-depth layer for tooling that walks the repo root.
frontend/**/node_modules/
frontend/**/dist/
frontend/**/*.tsbuildinfo
frontend/**/.vite/
frontend/**/coverage/
frontend/**/.next/   # reserved for future Next.js migration
frontend/**/.cache/
frontend/web/.env.local
frontend/web/.env.*.local
frontend/**/*.log
frontend/.DS_Store