# Enterprise Agent OS — environment variables
# All variables MUST be prefixed with EOS_. Copy to .env and fill in real values.
# NEVER commit .env; only .env.example is tracked.

# ── Core ────────────────────────────────────────────────────────────────
EOS_ENV=development                                    # development | test | ci | staging | production
EOS_DEBUG=true
EOS_LOG_LEVEL=INFO                                     # DEBUG | INFO | WARNING | ERROR
EOS_LOG_JSON=true                                      # true for non-dev; false for dev readability

# ── HTTP server ─────────────────────────────────────────────────────────
EOS_HTTP_HOST=0.0.0.0
EOS_HTTP_PORT=8100
EOS_HTTP_WORKERS=1
EOS_HTTP_REQUEST_BODY_MAX_BYTES=10485760               # 10 MB

# ── Database ────────────────────────────────────────────────────────────
EOS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eos_dev
EOS_DATABASE_POOL_SIZE=20
EOS_DATABASE_MAX_OVERFLOW=10
EOS_DATABASE_POOL_RECYCLE=3600
EOS_DATABASE_ECHO=false

# ── Redis ───────────────────────────────────────────────────────────────
EOS_REDIS_URL=redis://localhost:6379/0
EOS_REDIS_MAX_CONNECTIONS=50

# ── Object storage (MinIO dev / S3 prod) ────────────────────────────────
EOS_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
EOS_OBJECT_STORAGE_REGION=us-east-1
EOS_OBJECT_STORAGE_ACCESS_KEY=minioadmin
EOS_OBJECT_STORAGE_SECRET_KEY=minioadmin
EOS_OBJECT_STORAGE_BUCKET=eos-dev
EOS_OBJECT_STORAGE_SECURE=false

# ── Auth ────────────────────────────────────────────────────────────────
# Dev secret — replace via secret manager in staging/prod.
EOS_JWT_SECRET=dev-secret-not-for-production-use-only
EOS_JWT_ALGORITHM=HS256
EOS_JWT_ISSUER=eos-dev
EOS_JWT_AUDIENCE=eos-api
EOS_JWT_ACCESS_TTL_SECONDS=3600
EOS_API_KEY_HASH_ROUNDS=12

# ── Multi-tenancy ───────────────────────────────────────────────────────
# Stricter in non-dev. CI/peer review: EOS_BAN_MOCK_TOKEN must be 1 in CI.
EOS_BAN_MOCK_TOKEN=0
EOS_ALLOW_DEMO_TOKEN=1
EOS_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── LLM ─────────────────────────────────────────────────────────────────
EOS_LLM_PROVIDER=mock                                  # mock | openai | anthropic | deepseek
EOS_LLM_BASE_URL=https://api.openai.com/v1
EOS_LLM_API_KEY=                                       # leave empty for mock; required for real providers
EOS_LLM_DEFAULT_MODEL=gpt-4o-mini
EOS_LLM_TIMEOUT_SECONDS=30
EOS_LLM_MOCK_LATENCY_MS=50
EOS_LLM_FAILOVER_PROVIDERS=                            # comma-separated; e.g. anthropic,deepseek
EOS_LLM_EMBEDDING_MODEL=text-embedding-3-small
EOS_LLM_EMBEDDING_DIM=1536

# ── Sandbox ─────────────────────────────────────────────────────────────
EOS_SANDBOX_MODE=local                                 # local | docker | e2b
EOS_SANDBOX_RUN_TOKEN_SECRET=dev-sandbox-secret
EOS_SANDBOX_RUN_TOKEN_TTL_SECONDS=300
EOS_SANDBOX_NETWORK_POLICY=default                      # default | none | unrestricted
EOS_SANDBOX_DOCKER_SOCKET=/var/run/docker.sock

# ── Vector store ────────────────────────────────────────────────────────
EOS_VECTOR_PROVIDER=pgvector                           # pgvector | milvus
EOS_VECTOR_PGVECTOR_TABLE=memory_embeddings
EOS_VECTOR_MILVUS_HOST=
EOS_VECTOR_MILVUS_PORT=19530

# ── Event bus ───────────────────────────────────────────────────────────
EOS_EVENT_BUS=inprocess                                # inprocess | redis-stream
EOS_EVENT_REDIS_STREAM_PREFIX=eos:events:
EOS_EVENT_DLQ_STREAM=eos:events:dlq

# ── Rate limiting ───────────────────────────────────────────────────────
EOS_RATE_LIMIT_PER_TENANT_PER_MIN=1000
EOS_RATE_LIMIT_PER_API_KEY_PER_MIN=1000
EOS_RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS ────────────────────────────────────────────────────────────────
EOS_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
EOS_CORS_ALLOW_CREDENTIALS=true
EOS_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
EOS_CORS_ALLOW_HEADERS=*

# ── Observability ───────────────────────────────────────────────────────
EOS_OTLP_ENDPOINT=                                     # empty disables remote export; e.g. http://otel-collector:4317
EOS_METRICS_PATH=/metrics
EOS_TRACES_SAMPLE_RATE=1.0
EOS_SENTRY_DSN=                                        # empty disables Sentry
EOS_SENTRY_SAMPLE_RATE=0.1

# ── Memory expiry task ──────────────────────────────────────────────────
EOS_MEMORY_EXPIRY_INTERVAL_SECONDS=300

# ── Skill runtime (only used when EOS_SANDBOX_MODE=docker) ──────────────
EOS_SKILL_RUNTIME_URL=http://localhost:8093
EOS_SKILL_RUNTIME_TOKEN=dev-skill-runtime-token