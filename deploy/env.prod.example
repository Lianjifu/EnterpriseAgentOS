# Production environment template — DO NOT COMMIT REAL SECRETS
# Copy to ../.env.prod.  All *_REF values are resolved at startup by
# libs/vault.  Two schemes are supported:
#
#   vault:secret/data/<path>     HashiCorp Vault KV v2 lookup
#                                (consumed by HashicorpVaultSecretsResolver,
#                                optional extra: eos-vault[hashicorp])
#   csi:<KEY_NAME>               read /vault/secrets/<KEY_NAME> mounted by
#                                the Vault CSI driver
#                                (consumed by CSIVaultSecretsResolver)
#
# See infra/k8s/secret.example.yaml for the matching SecretProviderClass
# template and deploy/README.md for the rollout sequence.

EOS_ENV=production
EOS_RING=stable
EOS_APP_PORT=8102

# Database — secret ref only (vault supplies real password)
EOS_DATABASE_URL_REF=vault:secret/data/prod/eos/database_url
EOS_REDIS_URL_REF=vault:secret/data/prod/eos/redis_url

# JWT (CSI-mounted so the secret never appears as env)
EOS_JWT_SECRET_REF=csi:EOS_JWT_SECRET
EOS_JWT_TTL_SECONDS=3600
EOS_BAN_MOCK_TOKEN=1
EOS_ALLOW_DEMO_TOKEN=0

# Vault master keys for model / channel credentials (AES-GCM)
EOS_MODEL_MASTER_KEY_REF=csi:EOS_MODEL_MASTER_KEY

# Sandbox / run-token
EOS_RUN_TOKEN_SECRET_REF=csi:EOS_RUN_TOKEN_SECRET
EOS_SANDBOX_MODE=remote
EOS_SKILL_RUNTIME_URL=http://skill-runtime:8093

# Object storage
EOS_OBJECT_STORAGE_URL_REF=vault:secret/data/prod/eos/s3_url
EOS_OBJECT_STORAGE_BUCKET=eos-artifacts-prod

# LLM provider
EOS_LLM_PROVIDER=openai
EOS_OPENAI_API_KEY_REF=csi:EOS_OPENAI_API_KEY

# Canary header routing
EOS_CANARY_HEADER=X-EOS-Ring

# Observability
EOS_LOG_LEVEL=INFO
EOS_OTLP_ENDPOINT_REF=vault:secret/data/prod/eos/otlp_endpoint
EOS_SENTRY_DSN_REF=vault:secret/data/prod/eos/sentry_dsn

# Gunicorn tuning
EOS_GUNICORN_WORKERS=4
EOS_GUNICORN_THREADS=2
EOS_GUNICORN_TIMEOUT=60

# HashiCorp Vault resolver knobs (only consulted when EOS_*_REF starts
# with the ``vault:`` scheme; ignored otherwise)
# EOS_VAULT_URL=https://vault.internal:8200
# EOS_VAULT_MOUNT=secret
