# Production environment template — DO NOT COMMIT REAL SECRETS
# Copy to ../.env.prod and fill in vault-injected values.

EOS_ENV=production
EOS_RING=stable
EOS_APP_PORT=8102

# Database — secret ref only (vault supplies real password)
EOS_DATABASE_URL_SECRET_REF=vault://prod/eos/database_url
EOS_REDIS_URL_SECRET_REF=vault://prod/eos/redis_url

# JWT
EOS_JWT_SECRET_REF=vault://prod/eos/jwt_secret
EOS_JWT_TTL_SECONDS=3600
EOS_BAN_MOCK_TOKEN=1
EOS_ALLOW_DEMO_TOKEN=0

# Vault master keys for model / channel credentials (AES-GCM)
EOS_MODEL_MASTER_KEY_REF=vault://prod/eos/model_master_key
EOS_VAULT_MODE=kms

# Sandbox / run-token
EOS_RUN_TOKEN_SECRET_REF=vault://prod/eos/run_token_secret
EOS_SANDBOX_MODE=remote
EOS_SKILL_RUNTIME_URL=http://skill-runtime:8093

# Object storage
EOS_OBJECT_STORAGE_URL_SECRET_REF=vault://prod/eos/s3_url
EOS_OBJECT_STORAGE_BUCKET=eos-artifacts-prod

# LLM provider
EOS_LLM_PROVIDER=openai
EOS_OPENAI_API_KEY_REF=vault://prod/eos/openai_key

# Canary header routing
EOS_CANARY_HEADER=X-EOS-Ring

# Observability
EOS_LOG_LEVEL=INFO
EOS_OTLP_ENDPOINT_SECRET_REF=vault://prod/eos/otlp_endpoint
EOS_SENTRY_DSN_SECRET_REF=vault://prod/eos/sentry_dsn

# Gunicorn tuning
EOS_GUNICORN_WORKERS=4
EOS_GUNICORN_THREADS=2
EOS_GUNICORN_TIMEOUT=60
