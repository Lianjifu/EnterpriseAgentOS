# Production environment template — DO NOT COMMIT REAL SECRETS
# Copy to ../.env.prod.  All *_REF values are resolved at startup by
# libs/vault via ``composition/eos_app/.../ref_resolver.py`` before
# Pydantic reads env.  Two schemes are supported out of the box:
#
#   vault:secret/data/<path>     HashiCorp Vault KV v2 lookup
#                                (consumed by HashicorpVaultSecretsResolver)
#   csi:<KEY_NAME>               read /vault/secrets/<KEY_NAME> mounted by
#                                the Vault CSI driver
#                                (consumed by CSIVaultSecretsResolver)
#
# See infra/k8s/secret.example.yaml for the matching SecretProviderClass
# template and deploy/README.md for the rollout sequence.
#
# Required setting: ``EOS_VAULT_MODE=csi`` (or ``vault`` if you prefer the
# HashiCorp Vault path) — the resolver reads ``vault_mode`` from Pydantic
# Settings but the *_REF boot resolver instantiates each backend on its
# own (no dependency on vault_mode).

EOS_ENV=production
EOS_RING=stable

# Database — secret ref only (vault supplies real password)
EOS_DATABASE_URL_REF=vault:secret/data/prod/eos/database_url
EOS_REDIS_URL_REF=vault:secret/data/prod/eos/redis_url

# JWT (CSI-mounted so the secret never appears as env)
EOS_JWT_SECRET_REF=csi:EOS_JWT_SECRET
EOS_JWT_ACCESS_TTL_SECONDS=3600
EOS_BAN_MOCK_TOKEN=1
EOS_ALLOW_DEMO_TOKEN=0

# Vault master keys for model / channel credentials (AES-GCM)
EOS_MODEL_MASTER_KEY_REF=csi:EOS_MODEL_MASTER_KEY

# Sandbox / run-token
EOS_RUN_TOKEN_SECRET_REF=csi:EOS_RUN_TOKEN_SECRET
EOS_SANDBOX_MODE=remote
EOS_SKILL_RUNTIME_URL=http://skill-runtime:8093

# LLM provider
EOS_LLM_PROVIDER=openai
EOS_OPENAI_API_KEY_REF=csi:EOS_OPENAI_API_KEY

# Observability
EOS_LOG_LEVEL=INFO
EOS_OTLP_ENDPOINT_REF=vault:secret/data/prod/eos/otlp_endpoint

# Gunicorn tuning
EOS_GUNICORN_WORKERS=4
EOS_GUNICORN_THREADS=2
EOS_GUNICORN_TIMEOUT=60

# ── Distributed runtime (P10) ─────────────────────────────────────────────
# Audit pipeline (A5) — kafka replaces the synchronous SqlAuditLogAdapter
# for the prod hot path.  Canary pods set AUDIT_CONSUMER_ENABLED=false so
# only the stable pool drains the topic (no double-write to audit_log).
EOS_AUDIT_MODE=kafka
EOS_AUDIT_KAFKA_BOOTSTRAP_SERVERS=kafka.prod.svc.cluster.local:9092
EOS_AUDIT_KAFKA_TOPIC=eos.audit.events
EOS_AUDIT_KAFKA_DLQ_TOPIC=eos.audit.events.dlq
EOS_AUDIT_CONSUMER_ENABLED=true

# Event bus — redis-stream is required for multi-replica fan-out; the
# default in-process bus only works for the single-pod dev profile.
EOS_EVENT_BUS=redis-stream

# HashiCorp Vault resolver knobs (only consulted when EOS_*_REF starts
# with the ``vault:`` scheme; ignored otherwise)
# EOS_VAULT_URL=https://vault.internal:8200
# EOS_VAULT_MOUNT=secret

# ── Pack signing (Tier B) ────────────────────────────────────────────────
# Skill vetter — vault mode in prod pulls pubkeys from Vault KV v2.
# Knowledge / Plan vetters use local trust dirs mounted into the
# container at the path below.
EOS_SKILL_SIGNING_MODE=vault
EOS_SKILL_TRUST_DIR=/etc/eos/skill-trust
EOS_VAULT_SKILL_TRUST_REF=vault:secret/data/prod/eos/skill-trust/keys
EOS_VAULT_SKILL_TRUST_REFRESH_SECONDS=300
EOS_VAULT_SKILL_TRUST_MIN_KEYS=1
EOS_KNOWLEDGE_SIGNING_MODE=local
EOS_KNOWLEDGE_TRUST_DIR=/etc/eos/knowledge-trust
EOS_PLAN_SIGNING_MODE=local
EOS_PLAN_TRUST_DIR=/etc/eos/plan-trust

# ── Office pack seeders (Tier B) ─────────────────────────────────────────
EOS_PLATFORM_SEED_OFFICE_SKILL_PACKS=true
EOS_PLATFORM_OFFICE_SKILL_PACKS_ROOT=/srv/eos/packs/office/skills
EOS_PLATFORM_SEED_OFFICE_KNOWLEDGE_PACKS=true
EOS_PLATFORM_OFFICE_KNOWLEDGE_PACKS_ROOT=/srv/eos/packs/office/knowledge
EOS_PLATFORM_SEED_OFFICE_PLAN_PACKS=true
EOS_PLATFORM_OFFICE_PLAN_PACKS_ROOT=/srv/eos/packs/office/plans
