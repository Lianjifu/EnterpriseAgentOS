# Staging sandbox env — single-host docker run, no compose.
# Copy to deploy/env.staging (gitignored) and tweak.
#
# Sandbox deliberately avoids Vault / CSI / Kafka / OpenAI: vault_mode=noop
# so the boot-time *_REF resolver (composition/eos_app/.../ref_resolver.py)
# is a no-op for the regular fields.  We still wire ONE *_REF (EOS_OPENAI_API_KEY)
# via the env: scheme to verify the resolver actually fires in the container —
# watch the boot log for "resolved 1 EOS_*_REF env vars".

EOS_ENV=staging
EOS_RING=stable
EOS_LOG_LEVEL=INFO

# Database — points at the postgres container on the eos-staging network.
EOS_DATABASE_URL=postgresql+asyncpg://eos:eos@postgres:5432/eos

# Redis is not started in the sandbox; event bus is inprocess.
EOS_REDIS_URL=redis://localhost:6379/0

# JWT — sandbox only, NEVER reuse in any non-sandbox env.
EOS_JWT_SECRET=dev-jwt-secret-change-me-in-real-deployments
EOS_JWT_ACCESS_TTL_SECONDS=3600
EOS_BAN_MOCK_TOKEN=1
EOS_ALLOW_DEMO_TOKEN=0

# LLM provider — mock means no external calls during the sandbox run.
EOS_LLM_PROVIDER=mock

# Vault mode — noop skips resolver instantiation.  The single *_REF below
# still runs through ref_resolver.py because *_REF vars are processed before
# vault_mode is consulted.
EOS_VAULT_MODE=noop

# Audit + event bus — direct + inprocess keeps the sandbox self-contained.
EOS_AUDIT_MODE=direct
EOS_AUDIT_CONSUMER_ENABLED=false
EOS_EVENT_BUS=inprocess

# Skill runtime
EOS_SANDBOX_MODE=local
EOS_SKILL_RUNTIME_URL=http://127.0.0.1:8093

# Object storage — empty; knowledge assets write to local fs.
EOS_OBJECT_STORAGE_URL=

# Observability — empty in sandbox.
EOS_OTLP_ENDPOINT=
EOS_SENTRY_DSN=

# Gunicorn — 2 workers is enough for one sandbox pod.
EOS_GUNICORN_WORKERS=2
EOS_GUNICORN_THREADS=2
EOS_GUNICORN_TIMEOUT=60

# Ref-resolver smoke: validate composition/eos_app/.../ref_resolver.py
# boots + dispatches env: scheme.  INNER_OPENAI_KEY is the canonical name,
# EOS_OPENAI_API_KEY is unset on purpose so the resolver must write it.
INNER_OPENAI_KEY=sk-test-sandbox-not-real
EOS_OPENAI_API_KEY_REF=env:INNER_OPENAI_KEY